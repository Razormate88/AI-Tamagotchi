{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Razormate88/AI-Tamagotchi/main/brain/schema/secrets.schema.json",
  "title": "SpeciesSecretsBlueprint",
  "description": "Public definitions of discoverable history-based secret reactions and achievements.",
  "type": "object",
  "required": ["schemaVersion", "speciesId", "secrets"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "speciesId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "secrets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "name", "description", "icon", "reaction", "repeatable"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string" },
          "reaction": { "type": "string" },
          "repeatable": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
